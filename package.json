{
  "name": "@stromy/portal-kit",
  "version": "0.1.3",
  "description": "The evolving parts of a Stromy portal shell: data contract, gatekeeper client, sign-in glue, router, panel states, accessible primitives, SVG charts, runtime theme and test kit.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./testkit": "./src/testkit/index.ts",
    "./styles.css": "./src/styles/kit.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "preact": "11.1.1"
  },
  "dependencies": {
    "@azure/msal-browser": "5.27.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "happy-dom": "21.0.4",
    "preact": "11.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
